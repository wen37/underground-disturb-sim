    <model name="shearer">
      <static>false</static>
      <pose>0.6 5 0.6605 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>38.666667</ixx>
            <iyy>10.666667</iyy>
            <izz>38.666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>0.8 2.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>0.8 2.0 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.6 0.05 1</ambient>
            <diffuse>0.9 0.6 0.05 1</diffuse>
          </material>
        </visual>
        <gravity>false</gravity>
        <sensor name="shearer_laser_raw" type="ray">
          <pose>0 0 0.55 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>30.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="shearer_laser_ros" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/</namespace>
              <remapping>~/out:=/scan_raw</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>laser_link</frame_name>
          </plugin>
        </sensor>
      </link>
      <plugin name="coal_face_trajectory" filename="libcoal_face_trajectory.so">
        <y_min>5</y_min>
        <y_max>195</y_max>
        <period>1200</period>
        <x>0.6</x>
        <z>0.6605</z>
        <reference_rate>50</reference_rate>
      </plugin>
      <plugin name="shearer_ground_truth" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/</namespace>
          <remapping>odom:=/ground_truth</remapping>
        </ros>
        <body_name>base_link</body_name>
        <update_rate>50</update_rate>
        <xyz_offset>0 0 0</xyz_offset>
        <rpy_offset>0 0 0</rpy_offset>
        <gaussian_noise>0</gaussian_noise>
      </plugin>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>