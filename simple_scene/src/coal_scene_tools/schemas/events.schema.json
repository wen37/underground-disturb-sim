{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]*|S[0-9]{2}_[a-z][a-z0-9_]*)$"
    },
    "scene_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "advisory_only": {
      "const": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_window_s": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "time_window_s",
          "suggestion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "scene_version",
    "advisory_only",
    "events"
  ],
  "additionalProperties": false
}