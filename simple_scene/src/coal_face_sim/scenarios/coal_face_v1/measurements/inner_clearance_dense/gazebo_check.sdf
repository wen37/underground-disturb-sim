    <model name="probe_0">
      <static>true</static>
      <pose>0.0 1.3855583347321954e-13 1.0 0 1.5707963267948966 0.0</pose>
      <link name="probe">
        <sensor name="ray" type="ray">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>.001</min>
              <max>10</max>
              <resolution>.0001</resolution>
            </range>
          </ray>
          <plugin name="probe_0" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <remapping>~/out:=/clearance_check/probe_0</remapping>
            </ros>
            <output_type>sensor_msgs/Range</output_type>
            <frame_name>probe_0</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
