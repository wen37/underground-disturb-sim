    </model>
    <plugin name="states" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <gui>
      <camera name="user_camera">
        <pose>70 -70 70 0 .6 2.1</pose>
      </camera>
    </gui>
  </world>
</sdf>