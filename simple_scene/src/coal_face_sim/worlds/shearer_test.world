<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="shearer_test">
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.65 0.7 0.75 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.2 -1</direction>
    </light>
    <include>
      <uri>model://subt_tunnel_tile_5</uri>
      <name>tunnel_straight</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <gui>
      <camera name="user_camera">
        <pose>25 -30 20 0 0.45 2.27</pose>
      </camera>
    </gui>
  <model name="shearer">
  <static>false</static>
  <pose>0 0 1.0 0 0 0</pose>

  <link name="base_link">
    <inertial>
      <mass>100</mass>
      <inertia>
        <ixx>38.666667</ixx>
        <iyy>10.666667</iyy>
        <izz>38.666667</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
      </inertia>
    </inertial>

    <collision name="body_collision">
      <geometry>
        <box><size>0.8 2.0 0.8</size></box>
      </geometry>
    </collision>

    <visual name="body_visual">
      <geometry>
        <box><size>0.8 2.0 0.8</size></box>
      </geometry>
      <material>
        <ambient>0.9 0.6 0.05 1</ambient>
        <diffuse>0.9 0.6 0.05 1</diffuse>
      </material>
    </visual>
  </link>

  <plugin name="shearer_ground_truth" filename="libgazebo_ros_p3d.so">
    <ros>
      <namespace>/</namespace>
      <remapping>odom:=/ground_truth</remapping>
    </ros>
    <body_name>base_link</body_name>
    <update_rate>50</update_rate>
    <xyz_offset>0 0 0</xyz_offset>
    <rpy_offset>0 0 0</rpy_offset>
    <gaussian_noise>0</gaussian_noise>
  </plugin>
</model></world>
</sdf>