string geometry_id # 场景语义几何ID
string geometry_type # BOX/MESH
geometry_msgs/Point entry_point_m # map，射线段进入点
geometry_msgs/Point exit_point_m # map，射线段离开点
float64 distance_from_origin_m # 沿有限线段到进入点的距离m
geometry_msgs/Vector3 entry_normal # map单位外法向；退化接触返回零并在查询status说明
string material # 材料名称，UNKNOWN可用
float64 thickness_m # 语义标称厚度m；未知NaN
float64 path_length_m # 线段在此体内的实际长度m，不等于标称厚度
string reflection_level # LOW/MEDIUM/HIGH/UNKNOWN，定性事实而非误差参数
bool is_dynamic # 动态几何标记
